# ─────────────────────────────────────────────────────────────
# Home bot
# ─────────────────────────────────────────────────────────────
DISCORD_TOKEN=
GUILD_ID=1533152480328941778
HOME_CHANNEL_ID=1533161470697803968
# Optional. Leave blank; Home can rediscover its own Components V2 message.
HOME_MESSAGE_ID=

DISPLAY_TIME_ZONE=America/Chicago
REFRESH_INTERVAL_SECONDS=300
EVENT_REFRESH_DEBOUNCE_MS=2500
MESSAGE_SCAN_LIMIT=50
HOME_TAGLINE=Your little corner of the internet.

# Sync the title emoji to whatever Daykeeper currently puts on the Home channel/category.
SYNC_DAYKEEPER_THEME=true
DYNAMIC_ACCENT=true
ACCENT_COLOR=87A8B9

# ─────────────────────────────────────────────────────────────
# Privileged-intent enrichments
# ─────────────────────────────────────────────────────────────
# Needed to read Components V2/embed/content posted by the other bots.
READ_EXTERNAL_BOT_MESSAGES=true
# Needed for live role counts / fighter popularity. The bot still works without it.
ENABLE_MEMBER_STATS=true
# Non-privileged intent. Shows when people are hanging out in the configured voice rooms.
ENABLE_VOICE_ACTIVITY=true

# ─────────────────────────────────────────────────────────────
# Live Notify integration
# Uses the same public status API as the existing Live Notify service.
# ─────────────────────────────────────────────────────────────
ENABLE_LIVE_STATUS=true
STREAMER_USERNAME=twowhitaker
STREAMER_NAME=twoWhit
LIVE_STATUS_API_URL_TEMPLATE=https://tiktok-live-api-0k0j.onrender.com/live/{username}
LIVE_STATUS_TIMEOUT_MS=10000

